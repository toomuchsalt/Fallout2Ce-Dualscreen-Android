# Build on x86-64 without emulation. The resulting glibc baseline is older
# than Fedora 44 / Armada; SDL2's ABI is provided by Armada's SDL2-compat.
FROM docker.io/library/debian:trixie-slim
RUN dpkg --add-architecture arm64 && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates cmake git ninja-build g++-aarch64-linux-gnu libsdl2-dev:arm64 zlib1g-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
